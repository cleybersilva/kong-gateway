# Copy to .env (git-ignored) and fill in the values.

# Elasticsearch "elastic" user password, read by the Logstash pipeline.
# Generate with: docker exec elasticsearch /usr/share/elasticsearch/bin/elasticsearch-reset-password -u elastic -b -s
ELASTIC_PASSWORD=

# Datadog Agent (receives metrics from Kong's datadog plugin)
# API key: Datadog > Organization Settings > API Keys
DD_API_KEY=
# Datadog site: datadoghq.com (US1), us3.datadoghq.com, us5.datadoghq.com, datadoghq.eu, ap1.datadoghq.com
DD_SITE=datadoghq.com
